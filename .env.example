# OpenAI API-nøkkel (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Google Calendar ID (finn den i kalenderinnstillinger)
GOOGLE_CALENDAR_ID=abc123@group.calendar.google.com

# Meta WhatsApp Cloud API
# Finn disse i Meta Developer Dashboard → App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_ID=123456789012345

# Valgfri tilfeldig streng – brukes for å verifisere webhook mot Meta
WEBHOOK_VERIFY_TOKEN=mitt-hemmelige-token-123

# Familiemedlemmer som bruker boten (kommaseparert, med landkode)
# Boten sender svar til ALLE på listen uansett hvem som sendte meldingen
FAMILY_NUMBERS=+4712345678,+4798765432

# Cloudflare Tunnel token
# Finn i Cloudflare Zero Trust → Access → Tunnels → din tunnel → Configure → token
CLOUDFLARE_TUNNEL_TOKEN=eyJhxxx...
